        <mxCell id="ic" value="&lt;div style=&quot;font-weight:bold;text-align:center;border-bottom:1px solid #000;padding:3px 0&quot;&gt;INDUSTRY_CONSULTANTS&lt;/div&gt;&lt;table style=&quot;width:100%;border-collapse:collapse;font-size:10px&quot;&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;width:86px;color:#666&quot;&gt;PK,AI,NN&lt;/td&gt;&lt;td&gt;id (int)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:86px;color:#666&quot;&gt;NN&lt;/td&gt;&lt;td&gt;name (varchar(100))&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:86px;color:#666&quot;&gt;&lt;/td&gt;&lt;td&gt;status (varchar(16))&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:86px;color:#666&quot;&gt;NN,DEF&lt;/td&gt;&lt;td&gt;status_overridden (tinyint(1) : 0)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;width:86px;color:#666&quot;&gt;FK&lt;/td&gt;&lt;td&gt;period_id (int)&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacing=0;spacingTop=-2;fontSize=10;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1">
