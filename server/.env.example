# Course Assignment Module — Backend Environment
# Copy to .env and adjust as needed.

NODE_ENV=development
PORT=4000

# --- Module Database (this module owns this DB only) ---
DB_HOST=localhost
DB_PORT=3307
DB_NAME=course_assignment
DB_USER=ca_user
DB_PASSWORD=ca_password
DB_DIALECT=mysql

# Root creds used by docker-compose to bootstrap MySQL
DB_ROOT_PASSWORD=ca_root_password

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# Signs the session cookie. REQUIRED in production (the server refuses to boot
# without it). Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Every account email must be @<this domain> (exact match, no subdomains).
ALLOWED_EMAIL_DOMAIN=unc.edu.ph

# First admin (VPAA), created by `npm run db:seed:users`. Must be a UNC address.
# The admin is asked to change this password at first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Development only: the seed also creates six demo accounts, one per role, each
# with its own password — the list is in utils/seedUsers.js. To bring an
# existing database's demo accounts up to date: npm run db:seed:users -- --reset-demo

# --- Email ---
# capture = everything goes to Mailpit (http://localhost:8025), SMTP_* ignored.
#           The default outside production.
# live    = the real SMTP server below. Outside production, only addresses on
#           MAIL_DEV_ALLOWLIST are sent; anyone else is skipped.
# off     = log only, send nothing.
MAIL_MODE=capture
# Real SMTP, for MAIL_MODE=live. For Gmail: smtp.gmail.com, 465, true, the
# Gmail address, and a 16-character app password (see README → Testing email).
# Never commit a real password: this file is the example; put it in .env.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "UNC LPMS <lpms.sender@gmail.com>".
MAIL_FROM=
# Comma-separated addresses that may get REAL mail outside production.
MAIL_DEV_ALLOWLIST=
# Base of the links inside emails (e.g. the set-password link).
APP_BASE_URL=http://localhost:5173
# Mailpit's address for MAIL_MODE=capture. docker-compose sets the host to
# `mailpit`; running the server on the host, Mailpit is on localhost.
MAIL_CAPTURE_HOST=localhost
MAIL_CAPTURE_PORT=1025
