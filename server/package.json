{
  "name": "course-assignment-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend for the Course Assignment Module (UNC LPMS).",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test tests/",
    "db:seed:users": "node scripts/seedUsers.js",
    "db:fresh": "node scripts/purge.js",
    "db:purge": "node scripts/purge.js",
    "samples": "node scripts/make-sample-uploads.js",
    "mail:test": "node scripts/sendTestEmail.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^10.1.0",
    "pdfjs-dist": "^4.10.38",
    "sequelize": "^6.37.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.2"
  }
}
