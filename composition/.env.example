# Overrides for the LPMS composition stack. Copy to .env and edit as needed;
# every value below is the default that docker-compose.yml already uses.

# Published host ports. 5001/5174 are chosen so this stack can run at the same
# time as the Portfolio and Watch Party stacks.
LPMS_SERVER_PORT=5001
LPMS_CLIENT_PORT=5174

# Origin the browser loads the frontend from. The API is told to accept exactly
# this origin; if you change the frontend port, change this too.
LPMS_CLIENT_ORIGIN=http://localhost:5174

# URL the frontend uses to reach the API. It is resolved by the browser, so it
# must be the published host port of the backend, not an in-network address.
LPMS_API_BASE=http://localhost:5001

# "production" makes the API reject the published demo password, which locks out
# every account in this worktree. Only set it for a deployment with real users.
LPMS_NODE_ENV=development

# 1 = the sign-in screen lists the demo accounts and their shared password (only the ones that
# exist; the superuser is never listed). Ignored when NODE_ENV is production. Set 0 to hide.
LPMS_SHOW_DEMO_ACCOUNTS=1

# 1 = a brand-new empty database is filled with the demo data on first start (so a fresh clone is
# not empty). It never runs in production and never over a database that already has data. 0 = off.
LPMS_AUTO_SEED_DEMO=1

# --- Sessions, cookies and proxies ----------------------------------------------------------
# Sign-in sessions are stored in the database (8-hour limit, a new token on every sign-in).
# LPMS_COOKIE_SECURE: true = the session cookie is always Secure (https only); false = never;
# empty = automatic: Secure in production or when the request came over https, and NOT Secure over
# plain http, so http://localhost:5174 (or a LAN address) works in development.
LPMS_COOKIE_SECURE=
# LPMS_TRUST_PROXY: how many reverse proxies (nginx, a load balancer) stand in front of the API.
# Empty = none: X-Forwarded-* headers are ignored. Set 1 behind one proxy that terminates https, so the
# API knows the request was https (Secure cookie, HSTS). Do not set it if clients reach the API directly.
LPMS_TRUST_PROXY=

# --- Privacy Notice ---------------------------------------------------------------------------
# The Data Protection Officer named on the Privacy Notice page (/privacy). Names only here: put the
# real person in your own .env. Empty e-mail = the page says the contact has not been set up yet.
LPMS_DPO_NAME=
LPMS_DPO_EMAIL=

# --- E-signatures --------------------------------------------------------------------------
# Names only: put the real values in your own .env (which git ignores). Never commit a key.
# LPMS_SIGNATURE_KEY is 32 random bytes in base64; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = signatures off. If the key is lost or changed, saved signatures cannot be read.
# Raise LPMS_SIGNATURE_KEY_VERSION when you rotate the key (empty = 1).
LPMS_SIGNATURE_KEY=
LPMS_SIGNATURE_KEY_VERSION=

# --- Outgoing mail (credentials and password-reset links) -----------------------------------
# Empty HOST or FROM = mail off: a new account's temporary password is shown once to the
# superuser instead. PORT empty = 587. APP_URL empty = LPMS_CLIENT_ORIGIN.
LPMS_SMTP_HOST=
LPMS_SMTP_PORT=
LPMS_SMTP_USER=
LPMS_SMTP_PASS=
LPMS_SMTP_FROM=
LPMS_APP_URL=

# --- Other server settings ------------------------------------------------------------------
# Browser origins the API accepts, comma separated. docker-compose sets this from LPMS_CLIENT_ORIGIN,
# so leave it empty with Docker. Without Docker, list the frontend origin (for example
# http://localhost:5173). Outside production, http://localhost and http://127.0.0.1 are always accepted.
LPMS_ALLOWED_ORIGINS=
# 1 = anyone may register an account from any address. Empty = off: only the local demo (loopback
# address, not production) can self-register. Approver roles can never self-register remotely.
LPMS_ALLOW_PUBLIC_REGISTRATION=
# 1 = a password-reset link is shown on screen when no mail server is set up. Local demos only: it works
# only outside production and from the same machine. Leave empty for a real deployment.
LPMS_EXPOSE_RESET_TOKEN=
# Folder for the encrypted e-signature files. Empty = server/storage/signatures. docker-compose sets
# /app/storage/signatures, which lives in a named volume.
LPMS_SIGNATURE_DIR=
# Tests only (node run-tests.js): database file for a test that needs its own. The name must contain
# "test". Never set it in a real environment.
LPMS_TEST_DB_FILE=
