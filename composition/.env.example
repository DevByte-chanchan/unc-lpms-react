# Overrides for the LPMS composition stack. Copy to .env and edit as needed;
# every value below is the default that docker-compose.yml already uses.

# Published host ports. 5001/5174 are chosen so this stack can run at the same
# time as the Portfolio and Watch Party stacks.
LPMS_SERVER_PORT=5001
LPMS_CLIENT_PORT=5174

# Origin the browser loads the frontend from. The API is told to accept exactly
# this origin; if you change the frontend port, change this too.
LPMS_CLIENT_ORIGIN=http://localhost:5174

# URL the frontend uses to reach the API. It is resolved by the browser, so it
# must be the published host port of the backend, not an in-network address.
LPMS_API_BASE=http://localhost:5001

# "production" makes the API reject the published demo password, which locks out
# every account in this worktree. Only set it for a deployment with real users.
LPMS_NODE_ENV=development

# --- E-signatures --------------------------------------------------------------------------
# Names only: put the real values in your own .env (which git ignores). Never commit a key.
# LPMS_SIGNATURE_KEY is 32 random bytes in base64; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Empty = signatures off. If the key is lost or changed, saved signatures cannot be read.
# Raise LPMS_SIGNATURE_KEY_VERSION when you rotate the key (empty = 1).
LPMS_SIGNATURE_KEY=
LPMS_SIGNATURE_KEY_VERSION=

# --- Outgoing mail (credentials and password-reset links) -----------------------------------
# Empty HOST or FROM = mail off: a new account's temporary password is shown once to the
# superuser instead. PORT empty = 587. APP_URL empty = LPMS_CLIENT_ORIGIN.
LPMS_SMTP_HOST=
LPMS_SMTP_PORT=
LPMS_SMTP_USER=
LPMS_SMTP_PASS=
LPMS_SMTP_FROM=
LPMS_APP_URL=
