# UNC-LPMS Integrated Backend Environment
NODE_ENV=development
PORT=5000

# Unified MySQL 8.0 Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unc_lpms_integrated
DB_USER=root
DB_PASSWORD=rootdevpass
DB_DIALECT=mysql

# CORS & Frontend Origin
CORS_ORIGIN=http://localhost:5173
LPMS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
APP_BASE_URL=http://localhost:5173

# Authentication & Session Security
JWT_SECRET=unc-lpms-integrated-dev-secret-change-in-prod
ALLOWED_EMAIL_DOMAIN=unc.edu.ph
ALLOW_EXTERNAL_CONSULTANT_EMAILS=true
LPMS_SHOW_DEMO_ACCOUNTS=1
LPMS_COOKIE_SECURE=
LPMS_TRUST_PROXY=

# E-Signatures (32 random bytes base64)
LPMS_SIGNATURE_KEY=c2lnbmF0dXJlLWRldi1rZXktMzItYnl0ZXMtbG9uZyE=
LPMS_SIGNATURE_KEY_VERSION=1
LPMS_SIGNATURE_DIR=

# AI Multi-Provider Fallback Chain (Gemini -> Groq -> Mistral; falls back to offline OCR / deterministic TOC fallback when blank)
AI_PROVIDER_ORDER=gemini,groq,mistral
AI_REQUEST_TIMEOUT_MS=25000

# Provider 1: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash

# Provider 2: GroqCloud (OpenAI-compatible REST)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=llama-3.3-70b-versatile
GROQ_SEARCH_MODEL=openai/gpt-oss-120b

# Provider 3: Mistral AI (OpenAI-compatible REST)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FALLBACK_MODELS=ministral-8b-latest

CALENDAR_AI_PROVIDER=
LPMS_SCAN_AI=

# Mail (capture | live | off)
MAIL_MODE=off
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_DEV_ALLOWLIST=
MAIL_CAPTURE_HOST=localhost
MAIL_CAPTURE_PORT=1025

# Reminders & Academic Policy
MAX_TEACHING_UNITS=24
DEADLINE_REMINDERS=off
LPMS_REMINDERS=0
LPMS_TIMEZONE=Asia/Manila

# Optional Chromium/Edge path for server-side PDF rendering
LPMS_CHROME_PATH=
