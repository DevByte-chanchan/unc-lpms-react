# Ignore sensitive data and system files
infra/mysql/data/
.idea/
node_modules/
assignment/
submission/
tos/
dist/
build/
.env

# Only track your source folder
!composition/
# live database and its write-ahead log — never in git
composition/server/data/*.sqlite
composition/server/data/*.sqlite-shm
composition/server/data/*.sqlite-wal
composition/server/data/*.bak_*
# FUSE artifacts from files deleted while still open
.fuse_hidden*

# encrypted e-signature files
composition/server/storage/
# local database backups and rebuild leftovers
composition/server/data.bak_*/
composition/server/data.old_*/
composition/server/data/lpms_test.sqlite*
composition/server/tmp-*.sqlite*
