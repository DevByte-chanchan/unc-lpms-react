# Ignore sensitive data, system files, and local build artifacts
node_modules/
dist/
build/
.idea/
.vscode/
.vite/
.env
*.local
*.log

# Ignore non-composition module root folders and files
infra/
assignment/
submission/
tos/
config/
migrations/
models/
public/
seeders/
src/
eslint.config.js
index.html
package.json
package-lock.json
vite.config.js

# Only track composition module
!composition/
!composition/**
!.gitignore
!README.md
# Only track your source folder
!composition/
# live database and its write-ahead log — never in git
composition/server/data/*.sqlite
composition/server/data/*.sqlite-shm
composition/server/data/*.sqlite-wal
composition/server/data/*.bak_*
# FUSE artifacts from files deleted while still open
.fuse_hidden*

# encrypted e-signature files
composition/server/storage/
# local database backups and rebuild leftovers
composition/server/data.bak_*/
composition/server/data.old_*/
composition/server/data/lpms_test.sqlite*
composition/server/tmp-*.sqlite*

# stray empty SQLite file from an old default path
composition/server/config/database.sqlite
